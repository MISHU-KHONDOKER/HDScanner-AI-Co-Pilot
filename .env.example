# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Your API key for the OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=your_api_key_here

# Base URL for the OpenAI-compatible API. DeepSeek by default.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model to use for chat. DeepSeek's chat model by default.
CHAT_MODEL=deepseek-chat
